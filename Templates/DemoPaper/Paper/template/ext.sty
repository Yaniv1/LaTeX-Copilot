\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ext}[2026/10/20 Reusable manuscript extensions]

\RequirePackage{xparse}

\ExplSyntaxOn

\seq_new:N \l_enumpar_items_seq
\tl_new:N \l_enumpar_enum_tl
\tl_new:N \l_enumpar_delim_tl
\tl_new:N \l_enumpar_sep_tl
\tl_new:N \l_enumpar_conj_tl
\tl_new:N \l_enumpar_discard_tl
\int_new:N \l_enumpar_count_int

\cs_new_protected:Npn \enumpar_defaults:
  {
    \tl_set:Nn \l_enumpar_enum_tl { a }
    \tl_set:Nn \l_enumpar_delim_tl { ) }
    \tl_set:Nn \l_enumpar_sep_tl { ; }
    \tl_set:Nn \l_enumpar_conj_tl { and }
  }

\keys_define:nn { enumpar }
  {
    enum .choice:,
    enum / a .code:n = { \tl_set:Nn \l_enumpar_enum_tl { a } },
    enum / A .code:n = { \tl_set:Nn \l_enumpar_enum_tl { A } },
    enum / 1 .code:n = { \tl_set:Nn \l_enumpar_enum_tl { 1 } },
    enum / i .code:n = { \tl_set:Nn \l_enumpar_enum_tl { i } },
    enum / I .code:n = { \tl_set:Nn \l_enumpar_enum_tl { I } },
    delim .tl_set:N = \l_enumpar_delim_tl,
    sep .tl_set:N = \l_enumpar_sep_tl,
    conj .tl_set:N = \l_enumpar_conj_tl
  }

\cs_new:Npn \enumpar_label:n #1
  {
    \str_case:VnF \l_enumpar_enum_tl
      {
        { a } { \int_to_alph:n {#1} }
        { A } { \int_to_Alph:n {#1} }
        { 1 } { \int_to_arabic:n {#1} }
        { i } { \int_to_roman:n {#1} }
        { I } { \int_to_Roman:n {#1} }
      }
      { \int_to_alph:n {#1} }
  }

\cs_new_protected:Npn \enumpar_render:n #1
  {
    \seq_set_split:Nnn \l_enumpar_items_seq { \item } {#1}
    \seq_pop_left:NN \l_enumpar_items_seq \l_enumpar_discard_tl
    \int_set:Nn \l_enumpar_count_int
      { \seq_count:N \l_enumpar_items_seq }

    \seq_map_indexed_inline:Nn \l_enumpar_items_seq
      {
        \tl_set:Nn \l_tmpa_tl {##2}
        \tl_trim_spaces:N \l_tmpa_tl
        \enumpar_label:n {##1}
        \tl_use:N \l_enumpar_delim_tl
        \nobreakspace
        \tl_use:N \l_tmpa_tl

        \int_compare:nNnF {##1} = {\l_enumpar_count_int}
          {
            \int_compare:nNnTF {\l_enumpar_count_int} = {2}
              {
                \space
                \tl_use:N \l_enumpar_conj_tl
                \space
              }
              {
                \int_compare:nNnTF
                  {##1} = {\l_enumpar_count_int - 1}
                  {
                    \tl_use:N \l_enumpar_sep_tl
                    \space
                    \tl_use:N \l_enumpar_conj_tl
                    \space
                  }
                  {
                    \tl_use:N \l_enumpar_sep_tl
                    \space
                  }
              }
          }
      }
  }

\NewDocumentEnvironment{enumpar}{ O{} +b }
  {
    \par\noindent
    \group_begin:
    \enumpar_defaults:
    \keys_set:nn { enumpar } {#1}
    \enumpar_render:n {#2}
    \group_end:
    \par
  }
  { }

\ExplSyntaxOff
